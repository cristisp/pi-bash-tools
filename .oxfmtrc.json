{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "docs/handoffs/**",
    "package-lock.json",
    "README.md"
  ],
  "sortImports": true,
  "sortPackageJson": true
}
