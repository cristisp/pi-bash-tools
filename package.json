{
  "name": "@ztc/bash-tools",
  "version": "1.1.7",
  "description": "Safe bash tools for pi agents",
  "keywords": [
    "bash",
    "pi-extension",
    "pi-package",
    "security"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --format json --quiet",
    "fallow:dead-code": "fallow dead-code --format json --quiet",
    "fallow:dupes": "fallow dupes --format json --quiet",
    "fallow:health": "fallow health --format json --quiet",
    "fallow:list:entry-points": "fallow list --entry-points --format json --quiet",
    "fallow:list:boundaries": "fallow list --boundaries --format json --quiet"
  },
  "dependencies": {
    "typebox": "1.3.29"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "fallow": "^3.23.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
